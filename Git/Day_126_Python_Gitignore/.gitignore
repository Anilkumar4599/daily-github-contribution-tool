# ==========================================
# Python Git Ignore – Day 126
# ==========================================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Log files
*.log

# Test and coverage cache
.pytest_cache/
.coverage
htmlcov/

# Build and distribution files
build/
dist/
*.egg-info/

# IDE and editor settings
.vscode/
.idea/

# Operating system temporary files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak